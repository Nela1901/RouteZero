# Cadena de conexión de PostgreSQL (Supabase > Project Settings > Database > Connection string > URI).
# Si la contraseña tiene caracteres especiales, deben ir percent-encoded.
DATABASE_URL=
# Misma base de datos pero con el rol app_admin (BYPASSRLS). Solo para los jobs de mantenimiento
# (python -m src.auth.mantenimiento); la API web nunca usa este rol.
DATABASE_ADMIN_URL=

# Supabase > Project Settings > API.
SUPABASE_URL=
# Clave pública: se usa para casi todas las operaciones de Auth (login, MFA propio,
# renovar, cerrar tu propia sesión), reenviando el token del usuario. Igual que en apps cliente.
SUPABASE_ANON_KEY=

FRONTEND_ORIGIN=

# Cloudinary (Settings > API Keys / Dashboard). Almacena la foto del conductor; la firma de subida
# se genera en el backend, por lo que el API Secret nunca llega al navegador.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
